# ADAPTIVECACHE Frontend Environment Configuration Example
# Copy this file to .env or .env.local

# Backend REST API URL (Leave empty in local dev to use Vite proxy /api)
VITE_API_URL=

# Backend WebSocket Stream URL (Leave empty in local dev to autodetect window.location)
# Example: ws://localhost:8000/ws
# Example: wss://adaptivecache-api.yourdomain.com/ws
VITE_WS_URL=
