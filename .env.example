# ==============================================================================
# ADAPTIVECACHE Environment Configuration Template
# ==============================================================================

# Server Environment & Port
NODE_ENV=production
PORT=8000
CORS_ORIGIN=*
LOG_LEVEL=info

# Supabase / PostgreSQL Database Connection URL
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/adaptivecache

# Redis Cache Provider Connection URL (e.g. Upstash, Redis Cloud, or Local Redis)
# Example: rediss://default:[password]@[endpoint].upstash.io:6379
REDIS_URL=redis://localhost:6379

# Cache Engine Default Configuration
DEFAULT_TTL_SECONDS=300
MAX_CACHE_CAPACITY_BYTES=67108864

# Frontend URL bindings (Vite Build / Runtime)
# Used when building or running frontend independently
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
