# ADAPTIVECACHE Backend Environment Configuration Example
# Copy this file to .env and configure your variables

# Server Port
PORT=8000

# CORS Allowed Origin
CORS_ORIGIN=*

# PostgreSQL Database Connection URL (Supabase PostgreSQL or standard PG)
# Example: postgresql://postgres:password@localhost:5432/adaptivecache
# Example: postgres://postgres.project_ref:db_password@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Redis Connection URL (Live Cache)
# Example: redis://default:password@localhost:6379
# Example: rediss://default:password@eu1-key-cache.upstash.io:6379
REDIS_URL=

# Environment
NODE_ENV=development

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info
