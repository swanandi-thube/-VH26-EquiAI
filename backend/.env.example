# ==============================================================================
# ADAPTIVECACHE Backend Environment Configuration
# ==============================================================================

# Database Connection (Supabase PostgreSQL / Local PostgreSQL)
# Example Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Example Local PG: postgresql://postgres:password@localhost:5432/adaptivecache
DATABASE_URL=

# Redis Cache Provider Connection (Upstash / Redis Cloud / Local Redis)
# Example Upstash:  rediss://default:[password]@[endpoint].upstash.io:6379
# Example Local:    redis://localhost:6379
REDIS_URL=

# Server Port & CORS
PORT=8000
CORS_ORIGIN=*

# Server Environment & Logging
NODE_ENV=development
LOG_LEVEL=info

# Cache Engine Default Parameters
DEFAULT_TTL_SECONDS=300
MAX_CACHE_CAPACITY_BYTES=67108864
